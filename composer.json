{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/tgbot-module-antispam",
    "description": "Anti-spam module for the Telegram bot platform: deterministic rule engine, sliding-window counters, strikes and async enforcement",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "tg-bot",
        "telegram-bot",
        "bot-platform",
        "antispam",
        "anti-abuse",
        "module"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bagart/telegram-bot-lib": "*",
        "bagart/telegram-platform-management": "*",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramBotAntispam\\": "src/",
            "BAGArt\\TelegramBotAntispam\\Database\\Factories\\": "database/factories/",
            "BAGArt\\TelegramBotAntispam\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\TelegramBotAntispam\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php ../../../vendor/bin/pest"
        ]
    },
    "repositories": {
        "telegram-bot-lib": {
            "type": "path",
            "url": "../telegram-bot-lib"
        },
        "telegram-platform-management": {
            "type": "path",
            "url": "../telegram-platform-management"
        },
        "php-async-kernel-lib": {
            "type": "path",
            "url": "../php-async-kernel-lib"
        },
        "php-async-kernel-client": {
            "type": "path",
            "url": "../php-async-kernel-client"
        },
        "baseline": {
            "type": "path",
            "url": "../telegram-platform-devops-baseline"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "bagart/telegram-platform-devops-baseline": "@dev"
    }
}
